# Sorts groups of lines that start with a space, without moving them
# past the nearest line that does not start with a space.

multiline_sort () {
    $PYTHON3 -c '
import sys

buffer = []
while True:
    line = sys.stdin.readline()
    if not line:
        break
    if line.startswith(" "):
        buffer.append(line)
    else:
        sys.stdout.write("".join(sorted(buffer)))
        sys.stdout.write(line)
        buffer = []
sys.stdout.write("".join(sorted(buffer)))
'
}



