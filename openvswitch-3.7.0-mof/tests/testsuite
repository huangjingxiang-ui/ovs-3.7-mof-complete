"ovs-vswitchd.log"
$at_traceon; }


    duration=`sed -n 's/.*duration=\([0-9]*\)\(\.[0-9]*\)\{0,1\}s.*/\1/p' stdout`
    { set +x
printf "%s\n" "$at_srcdir/ofproto-dpif.at:9670: expr X\"\$duration\" : 'X[0-9][0-9]*\$'"
