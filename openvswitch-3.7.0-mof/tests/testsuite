# check_ancestors PID PARENT [GRANDPARENT...]
check_ancestors() {
    echo "checking ancestry: $*"
    local child=$1; shift
    { set +x
printf "%s\n" "$at_srcdir/daemon.at:25: kill -0 \$child"
at_fn_check_prepare_dynamic "kill -0 $child" "daemon.at:25"
( $at_check_trace; kill -0 $child
) >>"$at_stdout" 2>>"$at_stderr" 5>&-
at_status=$? at_failed=false
$at_check_filter
at_fn_diff_devnull "$at_stderr" || at_failed=:
at_fn_diff_devnull "$at_stdout" || at_failed=:
at_fn_check_status 0 $at_status "$at_srcdir/daemon.at:25"
$at_failed && at_fn_log_failure
$at_traceon; }

    while test $# != 0; do
        local parent=$1; shift
        { set +x
printf "%s\n" "$at_srcdir/daemon.at:28: parent_pid \$child"
at_fn_check_prepare_dynamic "parent_pid $child" "daemon.at:28"
( $at_check_trace; parent_pid $child
) >>"$at_stdout" 2>>"$at_stderr" 5>&-
at_status=$? at_failed=false
$at_check_filter
at_fn_diff_devnull "$at_stderr" || at_failed=:
echo stdout:; tee stdout <"$at_stdout"
at_fn_check_status 0 $at_status "$at_srcdir/daemon.at:28"
$at_failed && at_fn_log_failure
$at_traceon; }

        actual_parent=$(cat stdout)
        if test $parent = 1; then
            # Traditionally, if a parent's process exits, the process's new
            # parent is pid 1 (init) but this is not always the case these
            # days.  Instead, if the parent process should be pid 1, be
            # satisfied if the parent process is different from our own pid.
            if test $actual_parent = $$; then
                echo "parent of pid $child is this shell ($$) but should not be"
                printf "%s\n" "daemon.at:37" >"$at_check_line_file"
at_fn_check_skip 99 "$at_srcdir/daemon.at:37"
            fi
        elif test $parent != $actual_parent; then
            echo "parent of pid $child is $actual_parent but should be $parent"
            printf "%s\n" "daemon.at:41" >"$at_check_line_file"
at_fn_check_skip 99 "$at_srcdir/daemon.at:41"
        fi
        child=$parent
    done
}


