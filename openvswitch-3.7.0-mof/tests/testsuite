# If there's too much queuing skip the test to avoid timing out.
printf "%s\n" "ofproto.at:4980" >"$at_check_line_file"
(test $rmem_max -gt 1048576) \
  && at_fn_check_skip 77 "$at_srcdir/ofproto.at:4980"

