# Helper function to check the accuracy of distribution of packets over buckets
check_group_stats () {
    buckets=`grep -o 'packet_count=[0-9]*' | cut -d'=' -f2 | tail -n +2`
    i=0
    for bucket in $buckets; do
        min=$1
        shift
        if [ $bucket -ge $min ]; then
            echo "bucket$i >= $min"
        else
            echo "bucket$i < $min"
        fi
        i=`expr $i + 1`
        if [ $i -ge 4 ]; then break; fi
    done
}

